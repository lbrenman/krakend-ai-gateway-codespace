# Copy to .env ONLY if you are not using Codespaces secrets (e.g. running locally).
# .env is git-ignored. Codespaces secrets are the recommended way.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models used by the Enterprise /ai/* endpoints and by scripts/test.sh
OPENAI_MODEL=gpt-5-nano
ANTHROPIC_MODEL=claude-haiku-4-5

# Edition: auto (EE when ./LICENSE exists, else CE) | ce | ee
KRAKEND_EDITION=auto

# Optional: base64 of your KrakenD Enterprise LICENSE file (base64 -w0 LICENSE)
KRAKEND_LICENSE_B64=
